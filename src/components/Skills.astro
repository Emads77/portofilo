---
import { skills } from '../data/skills';
---
<section class="section" id="skills">
  <div class="container" data-reveal>
    <h2>Skills</h2>
    <div class="grid">
      {skills.map((skill) => (
        <div class="group">
          <h3>{skill.group}</h3>
          <ul>
            {skill.items.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .grid { display: grid; gap: var(--s-32); margin-top: var(--s-32); }
  .group { min-width: 0; }
  h3 { font-size: var(--text-body); letter-spacing: 0; }
  ul { margin-top: var(--s-8); color: var(--muted); font-size: var(--text-small); }
  li + li { margin-top: var(--s-4); }

  @media (min-width: 640px) {
    .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (min-width: 1024px) {
    .grid { grid-template-columns: repeat(5, minmax(0, 1fr)); }
  }
</style>
