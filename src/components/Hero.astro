---
import { profile } from '../data/profile';
---
<section class="hero container" id="top">
  <div class="text">
    <h1 data-reveal style="--i: 0">{profile.name}</h1>
    <p class="positioning" data-reveal style="--i: 1">{profile.positioning}</p>
    <p class="sub" data-reveal style="--i: 2">{profile.sub}</p>
    <div class="actions" data-reveal style="--i: 3">
      <a class="btn btn-fill" href="#work">See my work</a>
      <a class="btn btn-line" href="#contact">Contact</a>
    </div>
  </div>
  <div class="monogram" aria-hidden="true" data-reveal style="--i: 2">{profile.initials}</div>
</section>

<style>
  .hero { display: grid; gap: var(--s-48); padding-block: var(--s-72); }
  .text { min-width: 0; }
  h1 { font-size: var(--text-display); }
  .positioning { margin-top: var(--s-16); font-size: var(--text-lead); font-weight: 500; line-height: 1.3; letter-spacing: -0.01em; max-width: 26em; text-wrap: balance; }
  .sub { margin-top: var(--s-16); color: var(--muted); }
  .actions { display: flex; flex-wrap: wrap; gap: var(--s-12); margin-top: var(--s-32); }
  .monogram {
    display: grid;
    place-items: center;
    width: 100%;
    max-width: 120px;
    aspect-ratio: 1;
    border-radius: var(--radius);
    background: var(--accent);
    color: var(--on-accent);
    font-size: 2.5rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    order: -1;
  }

  @media (min-width: 640px) {
    .hero { grid-template-columns: minmax(0, 2fr) minmax(0, 1fr); align-items: center; }
    .monogram { order: 0; justify-self: end; max-width: 280px; font-size: clamp(4rem, 8vw, 6.5rem); }
  }

  @media (min-width: 1024px) {
    .hero { gap: var(--s-96); padding-block: var(--s-128); }
  }
</style>
